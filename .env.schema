# koburi runtime configuration
# Copy to .env and adjust. The .env file itself is gitignored.

# TCP port koburi listens on. Default: 9911.
KOBURI_PORT=9911

# Path to the container runtime unix socket. If unset, koburi auto-detects:
#   1. /var/run/docker.sock
#   2. /run/podman/podman.sock (rootful)
#   3. /run/user/$UID/podman/podman.sock (rootless, $UID must be set)
# Set this to override the auto-detect, e.g. for rootless docker or PM2 stats socket:
# SOCKET_DOCKER=/run/user/1000/docker.sock
# SOCKET_PODMAN=/run/podman/podman.sock
# SOCKET_PM2=/root/.pm2/rpc.sock

